# Local development defaults to mock AI and in-memory storage.
AI_PROVIDER=mock
STORAGE_PROVIDER=memory

# Frontend settings for an AWS-connected environment.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_AWS_REGION=ap-northeast-1

# AWS Bedrock settings for deployed environments.
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_ID=
BEDROCK_TEMPERATURE=0.8
BEDROCK_MAX_TOKENS=1200

# DynamoDB settings for deployed environments.
GAME_SESSIONS_TABLE=
PLAY_LOG_TTL_DAYS=1

# Game limits.
MAX_EXCUSE_LENGTH=600
PLAY_LIMIT_PER_DAY=20
